# Supabase: Project Settings, API. The URL is public; the service role key is
# not, and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The admin password, and the only admin credential. It signs the admin
# cookie, so changing it signs the board out and nothing else.
ADMIN_PASSWORD=

# Signs the cookies that say which customer or promoter somebody is. Its own
# key, so that changing the admin password no longer signs out the whole
# shop with it.
#
# Leave it empty and the admin password is used instead, which is what every
# cookie already out there was signed with: nothing changes and nobody is
# signed out. Fill it in and customers and promoters sign in again, once,
# with the PIN they already have, so it is a quiet morning job rather than
# something to do with a car on the road.
#
# Any long random string nobody else has. `openssl rand -base64 32` is the
# easy way; a password manager set to 32 characters is the same thing.
TOKEN_SECRET=

# Nothing else is set here. Bank details, the WhatsApp number, the handles and
# the home page line are all edited in Admin, Settings, so they change without
# a redeploy.

# Email to the admins, and only to the admins: a new order, and carts nobody
# finished. Get a key at resend.com; the free tier covers 3,000 a month. With
# no key set, nothing is emailed and everything still shows in admin.
RESEND_API_KEY=
# Optional. Until a domain is verified at Resend, leave this unset and mail
# goes out from onboarding@resend.dev.
EMAIL_FROM=

# Set it and the hourly abandoned-cart check can only be run by Vercel's
# scheduler, or by hand with ?key=... on the end. Required, not optional, for
# /api/cron/alerts: that one buzzes a phone, so with no secret set it refuses
# every request rather than running openly. Vercel's scheduler sends it as
# "Authorization: Bearer ...", which is what the route reads.
CRON_SECRET=

# Web push to the shop owner's own phone: a new order, a parcel, a cart left
# behind. Nothing to do with the customer app's notifications. Generate the
# pair once with `npx web-push generate-vapid-keys` and set both; the public
# one is sent to the browser by design, the private one never leaves the
# server. With neither set, nothing can be subscribed and admin works exactly
# as it did before.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Where the site lives. Used for the links in notifications and share cards,
# and as the VAPID subject a push service complains to.
NEXT_PUBLIC_SITE_URL=

# Claude, which makes the chat bot quicker to understand people. Entirely
# optional: with no key set the bot works exactly as it always has, by its
# own rules, and the same is true if the key runs out of credit or the API
# has a bad minute. The reading layer answers "I read nothing" and the rules
# take over, so the shop never stops taking orders because of this.
#
# It only ever reads a sentence and says what was in it. It does not price
# anything, decide what is in stock, or place an order: those stay in code
# that cannot be talked into a different answer.
#
# Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
