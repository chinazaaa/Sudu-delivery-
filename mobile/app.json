{
  "expo": {
    "name": "Sudu",
    "slug": "sudu",
    "scheme": "sudu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#ff5a1f",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "store.sudu.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:sudu.store",
        "applinks:www.sudu.store"
      ]
    },
    "android": {
      "package": "store.sudu.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff1ea"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sudu.store",
              "pathPrefix": "/g"
            },
            {
              "scheme": "https",
              "host": "www.sudu.store",
              "pathPrefix": "/g"
            },
            {
              "scheme": "https",
              "host": "sudu.store",
              "pathPrefix": "/o"
            },
            {
              "scheme": "https",
              "host": "www.sudu.store",
              "pathPrefix": "/o"
            },
            {
              "scheme": "https",
              "host": "sudu.store",
              "pathPrefix": "/r"
            },
            {
              "scheme": "https",
              "host": "www.sudu.store",
              "pathPrefix": "/r"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff5a1f"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ff5a1f"
        }
      ]
    ],
    "extra": {
      "api": "https://sudu.store",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a7ec1fff-4450-4588-8217-63b3c819849b"
      }
    },
    "owner": "fateround",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a7ec1fff-4450-4588-8217-63b3c819849b"
    }
  }
}
